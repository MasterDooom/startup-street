# Google Places API (New)
# Server-side only. Restrict the key in Google Cloud and enable Places API (New).
GOOGLE_MAPS_API_KEY=

# Optional AI provider (OpenAI-compatible Responses endpoint)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional database for the next persistence milestone
DATABASE_URL=

# Keep false in any real environment. Demo businesses are NEVER used by live discovery.
NEXT_PUBLIC_DEMO_MODE=false
